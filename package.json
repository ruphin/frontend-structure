{
  "name": "@ruphin/frontend-structure",
  "version": "0.1.0",
  "description": "Skeleton for a TypeScript frontend library built with Vite",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/elements/*.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./elements/*": {
      "types": "./dist/types/elements/*.d.ts",
      "import": "./dist/elements/*.js",
      "default": "./dist/elements/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
